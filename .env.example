# Local Inventory Service. Fill credentials in your own .env; never commit it.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=inventory_app
DB_PASSWORD=
DB_DATABASE=inventory
DB_SSL=false
DB_POOL_SIZE=20
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=3000
GRPC_BIND=127.0.0.1:50051
INVENTORY_PROTO_PATH=proto/inventory.proto

# Used by compose.yaml only; use different passwords for the two applications.
POSTGRES_ADMIN_PASSWORD=
MAIN_DB_USER=main_api
MAIN_DB_PASSWORD=
MAIN_DB_NAME=ecommerce
INVENTORY_DB_USER=inventory_app
INVENTORY_DB_PASSWORD=
INVENTORY_DB_NAME=inventory
JWT_SECRET=
API_PORT=3000

# Main product-display cache in compose.local.yaml (seconds).
PRODUCT_CACHE_TTL_SECONDS=60

# Tests use disposable databases, never DB_DATABASE above.
# TEST_DATABASE_URL=postgresql://test_user:test_password@127.0.0.1:55432/inventory_test
# TEST_MAIN_DATABASE_URL=postgresql://test_user:test_password@127.0.0.1:55432/ecommerce_test
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
